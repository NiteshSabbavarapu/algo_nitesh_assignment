# Django
SECRET_KEY=change-this
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=polygon_migration
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5433

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_SSL=False

# Polygon API (polygon.codeforces.com -> Settings -> API keys)
POLYGON_API_KEY=your-polygon-key
POLYGON_API_SECRET=your-polygon-secret

# AWS S3 (test files are uploaded here)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=ap-south-1

# -----------------------------------------------------------------------------
# Quick start
# -----------------------------------------------------------------------------
# 1. Start PostgreSQL and Redis (these host ports avoid clashes with local installs):
#    docker run --name polygon-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=polygon_migration -p 5433:5432 -d postgres:15
#    docker run --name polygon-redis -p 6380:6379 -d redis:7
# 2. Install packages:      pip install -r requirement.txt
# 3. Apply migrations:      python manage.py migrate
# 4. Create a staff user:   python manage.py createsuperuser
# 5. Run the server:        python manage.py runserver
# 6. Open:                  http://localhost:8000/